{
  "name": "toto-baby-book",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "또또 아기수첩 · 가족 육아기록 PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e:prepare && playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "node tools/verify-legacy.mjs && node tools/check-touch-size.mjs",
    "e2e:prepare": "node tools/prepare-e2e-vendor.mjs",
    "fetch:tailwind": "node tools/fetch-tailwind.mjs",
    "test:sql": "bash tools/sql-verify.sh",
    "build:core": "vite build --config vite.core.config.ts",
    "build:sql": "node tools/build-compact-sql.mjs",
    "build:css": "node tools/build-css.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@babel/standalone": "^7.26.4",
    "@playwright/test": "1.48.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
