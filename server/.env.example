# 서버 포트
PORT=4000
NODE_ENV=development

# 데이터베이스 (SQLite 기본). PostgreSQL 전환 예:
# DATABASE_URL="postgresql://user:pass@localhost:5432/travel?schema=public"
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# 업로드 디렉터리
UPLOAD_DIR="./uploads"

# CORS (콤마 구분, * 허용)
CORS_ORIGIN="*"

# 초기 관리자 계정
ADMIN_EMAIL="admin@travel.kr"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="관리자"

# 방문당 최대 사진 수
MAX_PHOTOS_PER_VISIT=20

# 샘플 데이터 생성 여부
SEED_SAMPLE=true
